{
  "name": "cf-email-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": "siumx",
  "license": "Apache-2.0",
  "scripts": {
    "init": "npm install && { d1=0; wrangler d1 create email-worker-db && wrangler d1 execute email-worker-db --remote --file=src/SQL/schema.sql && for f in src/SQL/*.sql; do [ \"$f\" = src/SQL/schema.sql ] || wrangler d1 execute email-worker-db --remote --file=\"$f\" || d1=1; done || d1=1; wrangler r2 bucket create email-worker; r2=$?; exit $((d1 || r2)); }",
    "deploy": "[ -d node_modules ] || npm install && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "member:setup": "node --experimental-strip-types scripts/member-admin.mjs",
    "test:workers": "node --test tests/workers-runtime.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260731.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.8.2",
    "wrangler": "^4.116.0"
  },
  "dependencies": {
    "jose": "^6.2.16"
  }
}
