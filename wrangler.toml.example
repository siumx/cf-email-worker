name = "cf-email-worker"
main = "src/index.ts"
compatibility_date = "2026-03-24"
account_id = ""

logpush = false

# 域名配置
[[routes]]
pattern = "webmail.example.com"
custom_domain = true

[[routes]]
pattern = "mailadmin.example.com"
custom_domain = true

[[d1_databases]]
binding = "DB"
database_name = "email-worker-db"

[[r2_buckets]]
binding = "R2"
bucket_name = "email-worker"

[assets]
directory = "./public"
run_worker_first = ["/api/*"]

# Wroker log
[observability]
enabled = true

# Worker Email
[[send_email]]
name = "EMAIL"

# 環境變數
[vars]
ADMIN_MAIL_HOSTS = ["mailadmin.example.com"]
SENDABLE_DOMAINS = ["notify.example.com"]