name = "cf-email-worker"
main = "src/index.ts"
compatibility_date = "2026-03-24"
compatibility_flags = ["nodejs_compat"]
#account_id = ""

# 禁用公共域名和預覽 URL
workers_dev = false
preview_urls = false

logpush = false

# 域名配置
[[routes]]
pattern = "webmail.example.com"
custom_domain = true

[[routes]]
pattern = "mailadmin.example.com"
custom_domain = true

[[d1_databases]]
binding = "DB"
database_name = "email-worker-db"
migrations_dir = "migrations"

[[r2_buckets]]
binding = "R2"
bucket_name = "email-worker"

[assets]
directory = "./public"
run_worker_first = ["/api/*"]

# Wroker log
[observability]
enabled = true

# Worker Email
[[send_email]]
name = "EMAIL"

# 環境變數
[vars]
# wrangler secret put MEMBER_PASSWORD_PEPPER
# wrangler secret put MEMBER_JWT_SECRET

ADMIN_MAIL_HOSTS = [] # ["mailadmin.example.com", "xxx.com" ...etc]
SENDABLE_DOMAINS = [] # ["notify.example.com", "bbb.com" ...etc]

RECEIVABLE_DOMAINS = [] # Member receive-domain choices; does not restrict Email Routing ingestion
MEMBER = { enable = false, admin = "admin", password = "change-me" }
# Applies only to ADMIN_MAIL_HOSTS. Without admin, member mode is disabled.
# Set MEMBER_PASSWORD_PEPPER and MEMBER_JWT_SECRET as secrets (or [vars] for local init).
